---
import Icon from "../components/Icon.astro";
import "../styles/base.css";
import "../styles/custom.css";
import { meta } from "../data/content";
import type { L } from "../data/content";

interface Props {
  title?: L;
  description?: L;
  /** Path of the page, for the canonical URL. */
  path?: string;
}

const { title = meta.title, description = meta.description, path = "/" } = Astro.props;
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description.es}
      data-i18n-meta
      data-es={description.es}
      data-en={description.en}
    />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <title data-i18n-title data-es={title.es} data-en={title.en}>{title.es}</title>
    <link rel="icon" type="image/svg+xml" href="/icons/na.svg" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title.es} />
    <meta property="og:description" content={description.es} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Applied before first paint so a returning reader never sees a flash of
      // the wrong language or theme. site.js takes over once the DOM is parsed.
      (() => {
        const root = document.documentElement;
        let lang = null;
        let theme = null;
        try {
          lang = localStorage.getItem("lang");
          theme = localStorage.getItem("theme");
        } catch {}

        if (lang === "en" || lang === "es") {
          root.lang = lang;
          root.dataset.lang = lang;
        }

        root.dataset.theme =
          theme === "light" || theme === "dark" || theme === "mixed" ? theme : "mixed";
      })();
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <dialog id="lightbox" class="lightbox" aria-label="Vista ampliada de proyecto">
      <button id="lightbox-close" class="lightbox-close" type="button" aria-label="Cerrar imagen">
        <Icon name="x" size={22} />
      </button>
      <img id="lightbox-image" src="" alt="" />
    </dialog>
    <script src="/js/site.js" is:inline></script>
    <script src="/js/molten.js" is:inline></script>
    <script src="/js/device-tilt.js" is:inline></script>
  </body>
</html>
