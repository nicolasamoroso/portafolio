---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout>
  <Header />
  <main>
    <section class="hero not-found" aria-labelledby="not-found-title">
      <div class="hero-top meta-copy">
        ERROR 404
        <br />
        PÁGINA NO ENCONTRADA
      </div>
      <p class="hero-index">404</p>
      <h1 id="not-found-title">
        {[..."404"].map((letter, index) => (
          <span
            class:list={["hero-letter", index === 0 && "hero-letter-first"]}
            style={`--letter:${index}`}
          >
            {letter}
          </span>
        ))}
      </h1>
      <div class="hero-bottom">
        <p>
          <span data-i18n data-es="Esta página no existe." data-en="This page doesn't exist.">
            Esta página no existe.
          </span>
        </p>
        <a class="scroll-prompt" href="/">
          <span data-i18n data-es="VOLVER AL INICIO" data-en="BACK HOME">
            VOLVER AL INICIO
          </span>
          <Icon name="arrow-down-left" class="scroll-icon" size={17} />
        </a>
      </div>
      <img class="not-found-art" src="/img/this-is-fine-404.gif" alt="" width="500" height="375" />
    </section>
  </main>
</Layout>

<style>
  .not-found h1 {
    letter-spacing: -0.09em;
  }

  .not-found-art {
    position: absolute;
    z-index: 1;
    right: 2.3vw;
    bottom: 96px;
    width: min(260px, 34vw);
    height: auto;
    border: 1px solid rgba(10, 10, 10, 0.3);
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: multiply;
  }

  @media (max-width: 760px) {
    .not-found-art {
      right: 6vw;
      bottom: 110px;
      width: 42vw;
    }
  }
</style>
