---
import ChapterMarker from "../ChapterMarker.astro";
import Icon from "../Icon.astro";
import T from "../T.astro";
import { projects, projectsCopy } from "../../data/content";
---

<section id="proyectos" class="chapter chapter-projects" aria-labelledby="projects-title">
  <ChapterMarker index="01" title={projectsCopy.title} id="projects-title" />

  <div class="project-reel-bar section-shell">
    <div class="reel-nav">
      <button
        type="button"
        class="reel-arrow"
        data-reel="prev"
        aria-controls="project-reel"
        aria-label="Anterior"
      >
        <Icon name="arrow-left" size={19} />
      </button>
      <button
        type="button"
        class="reel-arrow"
        data-reel="next"
        aria-controls="project-reel"
        aria-label="Siguiente"
      >
        <Icon name="arrow-right" size={19} />
      </button>
    </div>
  </div>

  <div
    id="project-reel"
    class="project-reel photo-reel project-carousel"
    data-autoplay="by-card"
    aria-label="Capturas de los proyectos"
  >
    {projects.map((project) => (
      <button
        type="button"
        data-lightbox={project.src}
        aria-label={`Ampliar captura de ${project.title}`}
      >
        <img
          src={project.src}
          alt={`Captura del sitio ${project.title}`}
          width="1080"
          height="542"
          loading="lazy"
          decoding="async"
        />
      </button>
    ))}
  </div>
  {projects.map((project, index) => (
    <article
      class:list={[
        "project-file",
        "section-shell",
        "reveal",
        index % 2 === 1 && "project-file-alt",
      ]}
    >
      <div class="project-file-head">
        <T t={project.kicker} as="p" class="eyebrow" />
        <T t={project.headline} as="h3" />
        <p class="project-file-meta">
          <span>{project.year}</span>
          {project.badge && <T t={project.badge} as="em" class="project-badge" />}
        </p>
      </div>

      <div class="project-file-body">
        {project.detail ? (
          <button
            type="button"
            class="project-file-shot"
            data-project-open={project.id}
            aria-haspopup="dialog"
            aria-label={`Ver detalle de ${project.title}`}
          >
            <img
              src={project.src}
              alt={`Captura del sitio ${project.title}`}
              width="1080"
              height="542"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true">
              <T t={projectsCopy.openDetail} as="b" /> <Icon name="maximize-2" />
            </span>
          </button>
        ) : (
          <a
            class="project-file-shot"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visitar ${project.title}`}
          >
            <img
              src={project.src}
              alt={`Captura del sitio ${project.title}`}
              width="1080"
              height="542"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true">
              {project.title} <Icon name="arrow-up-right" />
            </span>
          </a>
        )}
        <T t={project.description} as="p" class="project-file-copy" />
        {project.features && (
          <ul class="project-features">
            {project.features.map((feature) => (
              <T t={feature} as="li" />
            ))}
          </ul>
        )}
        <ul class="project-tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <p class="project-file-links">
          <a class="project-link" href={project.href} target="_blank" rel="noopener noreferrer">
            <T t={projectsCopy.visit} /> <Icon name="arrow-up-right" />
          </a>
          {project.github && (
            <a class="project-link" href={project.github} target="_blank" rel="noopener noreferrer">
              <T t={projectsCopy.code} /> <Icon name="arrow-up-right" />
            </a>
          )}
        </p>
      </div>
    </article>
  ))}

  {/* One dialog per project with a write-up, opened from the project's image.
      They live in the DOM (hidden) so every string is bilingual like the rest of
      the page and the language toggle swaps them in place. */}
  {projects.map(
    (project) =>
      project.detail && (
        <dialog
          class="project-dialog"
          id={`project-${project.id}`}
          aria-labelledby={`project-${project.id}-title`}
        >
          <button type="button" class="project-dialog-close" data-project-close aria-label="Cerrar">
            <Icon name="x" size={20} />
          </button>
          <div class="project-dialog-inner">
            <header class="project-dialog-head">
              <T t={project.kicker} as="p" class="eyebrow" />
              <h3 id={`project-${project.id}-title`}>{project.title}</h3>
              <p class="project-file-meta">
                <span>{project.year}</span>
                {project.badge && <T t={project.badge} as="em" class="project-badge" />}
              </p>
            </header>

            <div class="project-dialog-body">
              <section class="project-dialog-block project-dialog-summary">
                <T t={projectsCopy.summaryLabel} as="h4" />
                <T t={project.detail.summary} as="p" />
              </section>

              <section class="project-dialog-block">
                <T t={projectsCopy.useCasesLabel} as="h4" />
                <ul>
                  {project.detail.useCases.map((item) => (
                    <T t={item} as="li" />
                  ))}
                </ul>
              </section>

              <section class="project-dialog-block project-dialog-built">
                <T t={projectsCopy.builtLabel} as="h4" />
                <ul>
                  {project.detail.built.map((item) => (
                    <T t={item} as="li" />
                  ))}
                </ul>
              </section>
            </div>

            <ul class="project-tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>

            <section class="project-dialog-gallery">
              <T t={projectsCopy.galleryLabel} as="h4" />
              <div class="project-dialog-shots">
                {project.detail.gallery.map((shot) => (
                  <figure>
                    <button type="button" data-lightbox={shot.src} aria-label="Ampliar captura">
                      <img
                        src={shot.src}
                        alt={`${project.title}`}
                        width="1080"
                        height="600"
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                    <T t={shot.caption} as="figcaption" />
                  </figure>
                ))}
              </div>
            </section>

            <p class="project-file-links">
              <a class="project-link" href={project.href} target="_blank" rel="noopener noreferrer">
                <T t={projectsCopy.visit} /> <Icon name="arrow-up-right" />
              </a>
              {project.github && (
                <a
                  class="project-link"
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <T t={projectsCopy.code} /> <Icon name="arrow-up-right" />
                </a>
              )}
            </p>
          </div>
        </dialog>
      )
  )}
</section>
