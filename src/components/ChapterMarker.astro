---
/**
 * The numbered heading that opens each chapter. One component for all three, so
 * 01, 02 and 03 can't drift apart the way they had — each section used to reach
 * for the base's marker with slightly different overrides.
 */
import T from "./T.astro";
import type { L } from "../data/content";

interface Props {
  index: string;
  title: L;
  /** Optional standfirst. Lives inside the heading block rather than in its own
      section so it can't end up competing with the title for attention. */
  subtitle?: L;
  id: string;
}

const { index, title, subtitle, id } = Astro.props;
---

<div class="chapter-head section-shell reveal">
  <span class="chapter-head-number" aria-hidden="true">
    {index}
  </span>
  <T t={title} as="h2" id={id} />
  {subtitle && <T t={subtitle} as="p" class="chapter-head-sub" />}
</div>
